!.env.example
# Vercel needs this in the build — it's the DISABLE_ESLINT_PLUGIN=true flag
# that keeps CRA's CI=true from treating this codebase's pre-existing
# ESLint warnings (unused imports, missing hook deps, etc.) as build-
# breaking errors. Contains no secret — verified content is that one flag.
!.env.production
build/
.DS_Store
supabase/.temp/
*.local

